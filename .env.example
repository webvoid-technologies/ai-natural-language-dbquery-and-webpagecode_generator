GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Vision-capable model for the screenshot -> HTML/CSS module
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3

# Local SQLite database (no external DB required).
# Defaults to app/database/college.db — override only if you want a different file.
# DB_PATH=app/database/college.db
# DATABASE_URL=sqlite:///app/database/college.db

SQL_MAX_RETRIES=5

# Optional: path to tesseract binary (legacy, not used by the new modules)
TESSERACT_CMD=/opt/homebrew/bin/tesseract
